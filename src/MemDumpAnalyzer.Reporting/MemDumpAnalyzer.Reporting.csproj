<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsAotCompatible>True</IsAotCompatible>
		<EnableAotAnalyzer>true</EnableAotAnalyzer>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
	</PropertyGroup>
	<ItemGroup>
		<!-- Tells the trimmer to keep the Core model graph, which Scriban reads via reflection -->
		<EmbeddedResource Include="ILLink.Descriptors.xml">
			<LogicalName>ILLink.Descriptors.xml</LogicalName>
		</EmbeddedResource>
	</ItemGroup>
	<ItemGroup>
		<!-- Built-in skins and the OFL fallback fonts, read at runtime (works in the single-file AOT exe) -->
		<EmbeddedResource Include="Skins\BuiltIn\**\*" LogicalName="skins/%(RecursiveDir)%(Filename)%(Extension)" />
		<EmbeddedResource Include="Skins\Fonts\*.ttf" LogicalName="fonts/%(Filename)%(Extension)" />
		<None Include="Skins\Fonts\LICENSE-Liberation-OFL.txt" Link="licenses\LICENSE-Liberation-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="QuestPDF" Version="2026.9.1" />
		<PackageReference Include="Scriban" Version="7.5.3" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\MemDumpAnalyzer.Core\MemDumpAnalyzer.Core.csproj" />
	</ItemGroup>
</Project>

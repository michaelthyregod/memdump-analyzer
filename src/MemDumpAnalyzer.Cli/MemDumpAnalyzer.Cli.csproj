<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsAotCompatible>True</IsAotCompatible>
		<EnableAotAnalyzer>true</EnableAotAnalyzer>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<PublishAot>true</PublishAot>
		<VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
		<StripSymbols>false</StripSymbols>
		<PublishTrimmed>true</PublishTrimmed>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Spectre.Console" Version="0.57.3-alpha.0.29" />
		<PackageReference Include="System.CommandLine" Version="3.0.0-rc.3.26522.148" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MemDumpAnalyzer.Core\MemDumpAnalyzer.Core.csproj" />
		<ProjectReference Include="..\MemDumpAnalyzer.Reporting\MemDumpAnalyzer.Reporting.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- The repo's example skins next to the exe, as in the distribution zip (skins
orthwind) -->
		<None Include="..\..\skins\**\*" LinkBase="skins" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!--
	  Single-exe build: dotnet publish -c Release -r win-x64 -p:SingleExe=true
	  Native AOT can't link QuestPDF's native DLLs, so they are embedded as resources and extracted at
	  startup by NativeDependencies. The exe then runs on its own (the .pdb files are optional).
	-->
	<Target Name="EmbedQuestPdfNativeLibraries" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolvePackageAssets"
	        Condition="'$(SingleExe)' == 'true'">
		<Error Condition="'$(RuntimeIdentifier)' == ''" Text="SingleExe=true needs a runtime identifier, e.g. -r win-x64." />
		<ItemGroup>
			<_QuestPdfNative Include="@(NativeCopyLocalItems)"
			                 Condition="'%(Filename)' == 'qpdf' or '%(Filename)' == 'QuestPdfSkia'" />
			<EmbeddedResource Include="@(_QuestPdfNative)" LogicalName="native/%(Filename)%(Extension)" />
		</ItemGroup>
		<Error Condition="'@(_QuestPdfNative->Count())' != '2'" Text="Expected qpdf and QuestPdfSkia among the native assets for $(RuntimeIdentifier); found: @(_QuestPdfNative->'%(Filename)')" />
	</Target>

</Project>

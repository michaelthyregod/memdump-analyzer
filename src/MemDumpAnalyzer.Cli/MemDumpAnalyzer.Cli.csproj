<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsAotCompatible>True</IsAotCompatible>
		<EnableAotAnalyzer>true</EnableAotAnalyzer>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<PublishAot>true</PublishAot>
		<StripSymbols>false</StripSymbols>
		<PublishTrimmed>true</PublishTrimmed>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Spectre.Console" Version="0.57.2" />
		<PackageReference Include="System.CommandLine" Version="3.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MemDumpAnalyzer.Core\MemDumpAnalyzer.Core.csproj" />
		<ProjectReference Include="..\MemDumpAnalyzer.Reporting\MemDumpAnalyzer.Reporting.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- The repo's example skins next to the exe, as in the distribution zip (skins
orthwind) -->
		<None Include="..\..\skins\**\*" LinkBase="skins" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!--
	  Single-exe build: dotnet publish -c Release -r win-x64 -p:SingleExe=true
	  Native AOT can't link QuestPDF's native DLLs, so they are embedded as resources and extracted at
	  startup by NativeDependencies. The exe then runs on its own (the .pdb files are optional).
	  The files are picked by package, not by name: QuestPDF 2026.9.2 renamed them (qpdf to questpdf_qpdf,
	  QuestPdfSkia to questpdf_skia), and NativeDependencies works with whatever names they have.
	-->
	<Target Name="EmbedQuestPdfNativeLibraries" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolvePackageAssets" Condition="'$(SingleExe)' == 'true'">
		<Error Condition="'$(RuntimeIdentifier)' == ''" Text="SingleExe=true needs a runtime identifier, e.g. -r win-x64." />
		<ItemGroup>
			<_QuestPdfNative Include="@(NativeCopyLocalItems)" Condition="'%(NuGetPackageId)' == 'QuestPDF'" />
			<EmbeddedResource Include="@(_QuestPdfNative)" LogicalName="native/%(Filename)%(Extension)" />
		</ItemGroup>
		<Error Condition="'@(_QuestPdfNative-&gt;Count())' != '2'" Text="Expected QuestPDF's two native libraries (qpdf and Skia) among the native assets for $(RuntimeIdentifier); found: @(_QuestPdfNative->'%(Filename)')" />
	</Target>

</Project>
